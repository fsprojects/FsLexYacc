<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The lowest FSharp.Core published for .NET 10, and the floor our packages ask for. -->
    <PackageVersion Include="FSharp.Core" Version="10.0.100" />
    <!--
      Bootstrap only: the published tools generate the lexer and the parser that the tools in
      this repository are themselves built from. Never a dependency of what we ship.
    -->
    <PackageVersion Include="FsLexYacc" Version="13.0.0" />
    <PackageVersion Include="Ionide.KeepAChangelog.Tasks" Version="0.4.0" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="G-Research.FSharp.Analyzers" Version="0.25.0" />
    <PackageVersion Include="Ionide.Analyzers" Version="0.19.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Expecto" Version="11.1.0" />
    <PackageVersion Include="Expecto.FsCheck" Version="11.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
  </ItemGroup>
</Project>
