***********************************************************************************************
FsLexYacc.targets

WARNING:  DO NOT MODIFY this file unless you are knowledgeable about MSBuild and have
		  created a backup copy.  Incorrect changes to this file will make it
		  impossible to load or build your projects from the command-line or the IDE.

PowerPack build rules.

Copyright (C) Microsoft Corporation. All rights reserved.
***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<CompileDependsOn>CallFsLex;CallFsYacc;$(CompileDependsOn)</CompileDependsOn>
		<FsLexToolPath Condition="'$(FsLexToolPath)' == ''">$(MSBuildThisFileDirectory)/fslex/net10.0</FsLexToolPath>
		<FsLexToolExe Condition="'$(FsLexToolExe)' == ''">fslex.dll</FsLexToolExe>
		<FsYaccToolPath Condition="'$(FsYaccToolPath)' == ''">$(MSBuildThisFileDirectory)/fsyacc/net10.0</FsYaccToolPath>
		<FsYaccToolExe Condition="'$(FsYaccToolExe)' == ''">fsyacc.dll</FsYaccToolExe>
		<FsLexYaccToolRunner Condition="'$(UseFsLexYaccToolRunner)' != 'false' AND '$(FsLexYaccToolRunner)' == ''">dotnet </FsLexYaccToolRunner>
	</PropertyGroup>

	<!--
		FsLexYaccOutputToIntermediate=true writes the generated .fs and .fsi under $(IntermediateOutputPath)
		instead of next to the grammar. MSBuild only honours FileWrites under the output or intermediate
		folder, so this is what makes `dotnet clean` remove them. Projects reference the generated code as
		$(FsLexOutputFolder)Lexer.fs and $(FsYaccOutputFolder)Parser.fs(i).

		The defaults are resolved here, at evaluation time, so that the properties can be used in Compile items.
		That requires IntermediateOutputPath to be set already, which is the case when this file is imported
		through the NuGet package (after the SDK targets). A project that imports this file directly from its
		body evaluates it before the SDK targets, where IntermediateOutputPath is still empty; the Compile items
		would then silently point next to the grammar, so FsLexYaccCheckOutputFolders fails the build instead.
	-->
	<PropertyGroup Condition="'$(FsLexYaccOutputToIntermediate)' == 'true' AND '$(IntermediateOutputPath)' != ''">
		<FsLexOutputFolder Condition="'$(FsLexOutputFolder)' == ''">$(IntermediateOutputPath)</FsLexOutputFolder>
		<FsYaccOutputFolder Condition="'$(FsYaccOutputFolder)' == ''">$(IntermediateOutputPath)</FsYaccOutputFolder>
	</PropertyGroup>

	<Target Name="FsLexYaccCheckOutputFolders" Condition="'$(FsLexYaccOutputToIntermediate)' == 'true'">
		<Error
			Condition="'$(FsLexOutputFolder)' == '' OR '$(FsYaccOutputFolder)' == ''"
			Text="FsLexYaccOutputToIntermediate is set, but FsLexYacc.targets was imported before IntermediateOutputPath was defined, so FsLexOutputFolder and FsYaccOutputFolder could not be resolved. Import FsLexYacc.targets after the SDK targets (for example through the FsLexYacc NuGet package, or after an explicit &lt;Import Project=&quot;Sdk.targets&quot; Sdk=&quot;Microsoft.NET.Sdk&quot; /&gt;), or set FsLexOutputFolder and FsYaccOutputFolder yourself." />
	</Target>

	<!-- Build FsLex files. -->
	<Target
		Name="CallFsLex"
		Inputs="@(FsLex)"
		Outputs="@(FsLex->'$(FsLexOutputFolder)%(Filename).fs');@(FsLex->'$(FsLexOutputFolder)%(Filename).fsi')"
		Condition="'@(FsLex)'!=''"
		DependsOnTargets="FsLexYaccCheckOutputFolders"
		BeforeTargets="CoreCompile">

		<!-- Create the output directory -->
		<MakeDir Directories="$(FsLexOutputFolder)"/>
		<!-- Call FsLex -->
		<Exec Command="$(FsLexYaccToolRunner)&quot;$(FsLexToolPath)\$(FsLexToolExe)&quot;  -o &quot;$(FsLexOutputFolder)%(FsLex.Filename).fs&quot; %(FsLex.OtherFlags) %(FsLex.Identity)"/>
		<!-- Make sure it will get cleaned  -->
		<ItemGroup>
			<FileWrites Include="$(FsLexOutputFolder)%(FsLex.Filename).fs;$(FsLexOutputFolder)%(FsLex.Filename).fsi"/>
		</ItemGroup>
	</Target>

	<!-- Build FsYacc files. -->
	<Target
		Name="CallFsYacc"
		Inputs="@(FsYacc)"
		Outputs="@(FsYacc->'$(FsYaccOutputFolder)%(Filename).fs');@(FsYacc->'$(FsYaccOutputFolder)%(Filename).fsi')"
		Condition="'@(FsYacc)'!=''"
		DependsOnTargets="FsLexYaccCheckOutputFolders"
		BeforeTargets="CoreCompile">

		<!-- Create the output directory -->
		<MakeDir Directories="$(FsYaccOutputFolder)"/>
		<Exec Command="$(FsLexYaccToolRunner)&quot;$(FsYaccToolPath)\$(FsYaccToolExe)&quot;  -o &quot;$(FsYaccOutputFolder)%(FsYacc.Filename).fs&quot; %(FsYacc.OtherFlags) %(FsYacc.Identity)"/>

		<!-- Make sure it will get cleaned  -->
		<ItemGroup>
			<FileWrites Include="$(FsYaccOutputFolder)%(FsYacc.Filename).fs;$(FsYaccOutputFolder)%(FsYacc.Filename).fsi"/>
		</ItemGroup>
	</Target>
	<ItemGroup>
		<AvailableItemName Include="FsLex">
			<Visible>false</Visible>
		</AvailableItemName>
		<AvailableItemName Include="FsYacc">
			<Visible>false</Visible>
		</AvailableItemName>
	</ItemGroup>

	<!-- Register .fsl/.fsy files as build inputs for IDE fast up-to-date checks -->
	<ItemGroup>
		<UpToDateCheckInput Include="@(FsLex)" />
		<UpToDateCheckInput Include="@(FsYacc)" />
	</ItemGroup>
</Project>


